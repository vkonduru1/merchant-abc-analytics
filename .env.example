# ── AI Models ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=merchant_abc
POSTGRES_USER=abc_user
POSTGRES_PASSWORD=abc_dev_password

# ── FastAPI ────────────────────────────────────────────────────
DEBUG=true

# ── Data sources (for real Shopify/Klaviyo — not needed for synthetic data) ──
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_admin_api_token
KLAVIYO_API_KEY=your_klaviyo_private_api_key

# ── Synthetic data ────────────────────────────────────────────
SYNTHETIC_NUM_CUSTOMERS=500
SYNTHETIC_RANDOM_SEED=42
